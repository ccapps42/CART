# Python
__pycache__/
*.pyc
*.pyo

# Large binary data files (regenerate with data/build_bins.py)
data/**/*.bin
data/hf_cache/

# Model checkpoints
checkpoints/

# SQLite — results.db is committed as the released artifact (~5 MB).
# Ignore working files (WAL, shared memory) and any other .db files.
*.db
!results.db
*.db-shm
*.db-wal

# Generated figure outputs (sources are tracked, regenerate via figures/gen_*.py)
figures/*.png
figures/*.pdf

# LaTeX compile artifacts
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/cart_paper.pdf

# Screenshots / scratch images at repo root
/Screenshot*.jpg
/Screenshot*.jpeg
/Screenshot*.png

# Generated sweep outputs
sweep/stage2_configs.json

# Claude Code settings
.claude/

# Local submission staging (NOT for the public repo).
# TMLR/ holds the double-blind anonymized build — must never be committed/pushed.
/arXiv/
/TMLR/

# Internal working docs and dev/maintenance scripts (not part of the public release)
/CLAUDE.md
/HANDOFF.md
/Model_Paper_1_spec.md
/Notes for Writing the Paper.md
/Run baselines with.txt
/preflight_d768.py
/reset_*.py
/test_phase*.py
